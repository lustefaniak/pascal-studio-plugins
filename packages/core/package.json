{
  "name": "@lustefaniak/pascal-studio-core",
  "version": "0.2.0",
  "description": "Shared plumbing for the Pascal Studio plugins: the studio worker client, the project's room list, the shared store and model placement. Not a plugin by itself.",
  "type": "module",
  "license": "MIT",
  "author": "Łukasz Stefaniak (https://github.com/lustefaniak)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lustefaniak/pascal-studio-plugins.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lustefaniak/pascal-studio-plugins/issues"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lustefaniak/pascal-studio-plugins/tree/main/packages/core#readme",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rooms": {
      "types": "./src/rooms.ts",
      "default": "./src/rooms.ts"
    }
  },
  "keywords": [
    "pascal",
    "pascal-editor",
    "plugin"
  ],
  "peerDependencies": {
    "@pascal-app/core": "^1.0.3",
    "@pascal-app/editor": "^1.0.3",
    "@pascal-app/viewer": "^1.0.3",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "three": "^0.186",
    "zod": ">=4.5.4 <4.6",
    "zustand": "^5"
  }
}
